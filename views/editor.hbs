<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{title}}</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Prata&display=swap" rel="stylesheet"><link rel="stylesheet" href="/styles.css"></head>
<body>{{> header}}<main class="editor-page"><div class="editor-heading"><p class="eyebrow">Редакционная</p><h1>Новая история</h1><p>Расскажите о том, что важно. Хороший текст начинается с ясной мысли.</p></div><form id="editor-form" class="editor-form"><label>Заголовок<input name="title" required maxlength="120" placeholder="О чём эта история?"></label><label>Тема<select name="categoryId" id="category-select" required><option value="">Выберите тему</option></select></label><label>Текст<textarea name="description" required rows="12" placeholder="Начните писать здесь…"></textarea></label><label>Обложка<input type="file" name="cover" accept="image/jpeg,image/png,image/gif"></label><p class="form-error" id="form-error"></p><div class="editor-actions"><a href="/">Отменить</a><button class="button button-dark">Опубликовать</button></div></form></main><script src="/app.js"></script></body></html>
